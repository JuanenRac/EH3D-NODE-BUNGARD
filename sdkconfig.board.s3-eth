# EH3D-NODE-BUNGARD, board profile s3-eth: the Waveshare ESP32-S3-ETH (ESP32-S3R8, 16 MB flash, W5500 over SPI, PoE). Copyright (C) 2026 JuanenRac (Electro Hobby 3D). GPL-3.0-or-later.
CONFIG_EH3D_BOARD_S3_ETH=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ETH_SPI_ETHERNET_DM9051=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n
