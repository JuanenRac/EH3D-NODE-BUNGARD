menu "EH3D Bungard node"

# The board the image is for. The build script picks it (sdkconfig.board.<board>); the two profiles differ in the pin table, in the default way in
# (the cable or Wi-Fi) and in whether the W5500 Ethernet driver is built.
choice EH3D_BOARD
    prompt "Board"
    default EH3D_BOARD_S3_WIFI

config EH3D_BOARD_S3_WIFI
    bool "s3-wifi: ESP32-S3-WROOM-1 N16R8 (no Ethernet; Wi-Fi only)"

config EH3D_BOARD_S3_ETH
    bool "s3-eth: Waveshare ESP32-S3-ETH (W5500 Ethernet over SPI, PoE)"

endchoice

# Almost everything a node needs is set in its web panel and stored in flash: its identity, its Wi-Fi, the access token of the control link, the pins and the spindle. The values below are
# only the FIRST settings of a freshly flashed node (used while the flash holds no configuration), and a build with all of them empty is a generic image that is configured entirely
# from the panel. The factory values of the machine settings (pins, port, spindle) are in core/bungard_config.hpp.

config EH3D_NODE_ID
    string "First node identifier (empty: bungard-<last three bytes of the MAC>)"
    default ""
    help
        Lowercase letters, digits, '-' and '_' (1 to 64, not starting with '-' or '_').

config EH3D_SETUP_CODE
    string "Setup code (empty: a random one made the first time and kept, shown on the USB console)"
    default ""
    help
        The first administrator of a node is created with this code, from the panel. 8 to 32 characters.

config EH3D_BOOT_FACTORY_RESET
    bool "BOOT button erases the settings (hold it 8 s in the first 30 s after power-up)"
    default y
    help
        Whoever can reach the board can wipe the node's settings and users with the button. Turn it off for a node in a place anyone can open; the reset of the panel (an administrator) stays.

config EH3D_NTP_SERVER
    string "NTP server (the clock of the log and of the panel)"
    default "pool.ntp.org"
    help
        On a network without Internet access, point this at a server of your own.

menu "Ethernet (W5500 over SPI)"
    depends on EH3D_BOARD_S3_ETH

config EH3D_ETH_SPI_HOST
    int "SPI host of the W5500 (1 = SPI2, 2 = SPI3)"
    range 1 2
    default 1
config EH3D_ETH_MOSI
    int "W5500 MOSI GPIO"
    default 11
config EH3D_ETH_MISO
    int "W5500 MISO GPIO"
    default 12
config EH3D_ETH_SCLK
    int "W5500 SCLK GPIO"
    default 13
config EH3D_ETH_CS
    int "W5500 chip select GPIO"
    default 14
config EH3D_ETH_INT
    int "W5500 interrupt GPIO"
    default 10
config EH3D_ETH_RST
    int "W5500 reset GPIO (-1 if not wired)"
    default 9
config EH3D_ETH_SPI_MHZ
    int "SPI clock in MHz"
    range 1 40
    default 20
    help
        The W5500 accepts much more; 20 MHz leaves margin on jumper wires.

endmenu

endmenu
